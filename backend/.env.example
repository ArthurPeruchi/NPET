# Copie este arquivo para .env e ajuste os valores conforme necessário:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env  (Windows)

# Nome da aplicação (aparece na doc do Swagger):
APP_NAME=NPET API

# Ambiente de execução: DEV, QAS, PRD:
APP_ENV=development

# Porta usada pelo servidor Uvicorn:
PORT=8000

# Prefixo base de todas as rotas da API:
API_PREFIX=/api/v1

# Habilita comportamentos de depuração (logs mais verbosos, etc.):
DEBUG=true

#URL Banco de dados
DATABASE_URL=postgresql+psycopg2://USER:SENHA@HOST:5432/NOME_BANCO

# Chave que assina os tokens JWT. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave

# Validade do token de acesso, em minutos:
JWT_EXPIRE_MINUTES=30

# Senha dos usuários de instituição criados pelo seed (scripts/db_seed_instituicoes.py).
# Apenas para desenvolvimento; se vazia, o script pede a senha no terminal.
SEED_PASSWORD=

# Redefinição de senha ("esqueci minha senha"):
# o link enviado por e-mail é FRONTEND_URL + RESET_PASSWORD_PATH + ?token=...
FRONTEND_URL=http://localhost:5173
RESET_PASSWORD_PATH=/redefinir-senha
RESET_TOKEN_EXPIRE_MINUTES=15

# SMTP para envio de e-mails. Deixe SMTP_HOST vazio em desenvolvimento:
# o e-mail (com o link) é apenas impresso no log da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NPET <nao-responda@npet.com.br>
SMTP_STARTTLS=true

# Mercado Pago (Checkout Transparente). No sandbox use as credenciais de teste (TEST-...).
# MP_ACCESS_TOKEN: Painel do MP > Suas integrações > Credenciais. Nunca exponha no frontend.
MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET: "Assinatura secreta" da seção Webhooks do painel (valida o x-signature).
MP_WEBHOOK_SECRET=
# URL pública de POST /api/v1/pagamentos/webhook (ex.: via ngrok em dev). Vazia = sem webhook.
MP_NOTIFICATION_URL=
MP_API_URL=https://api.mercadopago.com
# Validade do QR Code PIX, em minutos:
MP_PIX_EXPIRATION_MINUTES=30
# Timeout (segundos) e retry das chamadas ao Mercado Pago. O retry repete falhas de rede,
# 429 e 5xx até MP_MAX_RETRIES vezes, com espera exponencial a partir de MP_RETRY_BACKOFF_SECONDS.
MP_TIMEOUT_SECONDS=20
MP_CONNECT_TIMEOUT_SECONDS=5
MP_MAX_RETRIES=2
MP_RETRY_BACKOFF_SECONDS=0.5
